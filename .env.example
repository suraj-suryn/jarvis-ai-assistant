# JARUS Environment Variables — copy to .env and fill in values
# NEVER commit the actual .env file

# Google OAuth2 (from Google Cloud Console → APIs & Services → Credentials)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# AES-256 encryption secret (any random 32-char string)
APP_ENCRYPTION_SECRET=

# Your Gmail address — gets ADMIN role automatically
ADMIN_EMAIL=

# Google Cloud project ID
GCP_PROJECT_ID=

# GCS bucket name for file storage
GCS_BUCKET_NAME=jarus-files

# Google Custom Search (optional, for company research links)
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=

# VAPID keys for Web Push (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Path to service account JSON (for local dev)
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json
